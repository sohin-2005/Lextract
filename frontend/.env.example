# ---------------------------------------------------------------------------
# Frontend environment
# ---------------------------------------------------------------------------
#
# LOCAL DEVELOPMENT: leave this blank.
#   `npm run dev` proxies /api to http://localhost:8000 (see vite.config.js),
#   so requests are same-origin and no base URL is needed.
#
# PRODUCTION: this is REQUIRED.
#   The Vite proxy is a dev-server feature and does not exist in a built
#   bundle. With this unset, the deployed app calls /api on its own origin —
#   e.g. https://your-app.vercel.app/api/health — where no backend exists,
#   and every request fails.
#
#   Set it to your backend's origin, with NO trailing slash and NO /api suffix:
#     VITE_API_BASE_URL=https://your-backend.onrender.com
#
#   Vite inlines this at BUILD time, so changing it needs a redeploy, not
#   just a restart.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
