# ===========================================================================
#  Lextract -- backend environment
#
#  Copy this file to  backend/.env  and fill in the blanks:
#      cp .env.example .env
#
#  .env is git-ignored. Never commit real keys.
# ===========================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# EASIEST: let Docker run Postgres for you --  docker compose up -d db
#   then use exactly the line below, it already matches the compose credentials.
#
# Running Postgres natively instead? Homebrew creates a role named after your
# macOS user, NOT "postgres", so `...://postgres:postgres@...` fails with
# 'role "postgres" does not exist'. Use your own username:
#   DATABASE_URL=postgresql+asyncpg://$(whoami)@localhost:5432/taxor_bills
#
# The app rewrites postgresql:// to postgresql+asyncpg:// automatically, so
# either form works.
DATABASE_URL=postgresql+asyncpg://taxor:taxor@localhost:5432/taxor_bills

# ---------------------------------------------------------------------------
# LLM API keys  -- you need at least TWO for the comparison to mean anything
#
# Any two of the six below will do. The all-free combination is
# Gemini + Groq + SambaNova + Mistral + NVIDIA: five vision models, no card,
# no spend.
# ---------------------------------------------------------------------------

# Google AI Studio.  FREE, no credit card, ~60 seconds to set up.
#   https://aistudio.google.com/app/apikey
#   -> "Create API key" -> copy. Free tier covers Flash models.
GOOGLE_API_KEY=

# Anthropic Console.  PAID -- a Claude Pro/Max subscription does NOT include
# API credits; they are billed separately. $5 is plenty for this project.
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI Platform.  PAID -- minimum $5 top-up.
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- OpenAI-compatible providers -------------------------------------------
# These three speak the same wire format as OpenAI, so they need no extra SDK.
# All are vision-capable and all have a free tier, which makes them the
# cheapest way to get a real multi-model comparison running.

# Groq.  FREE tier, no card. Fastest inference of the six.
#   https://console.groq.com/keys
GROQ_API_KEY=

# SambaNova Cloud.  FREE tier, no card.
#   https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# Mistral AI.  FREE "Experiment" tier, no card.
#   https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# NVIDIA NIM.  FREE credits on signup, no card.
#   https://build.nvidia.com/  -> pick a vision model -> "Get API Key"
NVIDIA_API_KEY=

# Moonshot AI (Kimi).  Free trial credits on signup.
#   https://platform.kimi.ai/console/api-keys
# Keys look like sk-...  Model IDs have NO prefix: "kimi-k2.6".
MOONSHOT_API_KEY=

# OpenRouter.  One key that fronts most other labs' models, incl. Kimi.
#   https://openrouter.ai/keys
# Keys start with sk-or-v1-...  Model IDs ARE namespaced: "moonshotai/kimi-k2.6".
# Sending an OpenRouter key to Moonshot (or vice versa) returns a bare 401.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Model selection
# ---------------------------------------------------------------------------
# Model IDs live here, not in code, so a deprecation is a one-line change.
# All three must be vision-capable. Defaults are the cheapest current vision
# tier from each provider.
# gemini-2.5-flash is closed to new API accounts and 404s on a fresh key.
GEMINI_MODEL=gemini-3.5-flash

# Gemini 2.5+ thinks by default and charges those tokens against the output
# budget, which truncates the JSON mid-object. Transcription needs no
# reasoning. Blank disables the setting if your model rejects it.
GEMINI_THINKING_LEVEL=low
CLAUDE_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-5-mini

# Groq vision model. Check the current list: https://console.groq.com/docs/vision
GROQ_MODEL=qwen/qwen3.6-27b

# Qwen 3.6 is a REASONING model. Left on, it wraps its answer in <think>
# tags and can burn the entire token budget before emitting any JSON.
# Extraction is transcription, not puzzle-solving, so turn it off.
# 'none' disables it (Qwen only); blank sends no reasoning parameters.
GROQ_REASONING_EFFORT=none

# SambaNova vision model. Alternative: Llama-4-Scout-17B-16E-Instruct
SAMBANOVA_MODEL=Llama-4-Maverick-17B-128E-Instruct

# Mistral vision model. Alternatives: pixtral-large-latest (stronger, ~13x the
# cost), mistral-medium-latest
MISTRAL_MODEL=pixtral-12b-latest

# NVIDIA NIM vision model. Alternative: meta/llama-3.2-90b-vision-instruct
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Moonshot vision model. kimi-k2.6 has a non-thinking mode and is far cheaper
# than the kimi-k3 flagship ($3/$15 per Mtok, always-on reasoning).
# Do NOT use moonshot-v1-*-vision-preview: being sunset, unavailable to new accounts.
MOONSHOT_MODEL=kimi-k2.6

# OpenRouter model. Browse them at https://openrouter.ai/models?modality=text+image
# Must be vision-capable. Note the lab prefix -- that is how you tell an
# OpenRouter model ID from a native one.
OPENROUTER_MODEL=moonshotai/kimi-k2.6

# Endpoints, in config so a provider moving its URL is not a code change.
GROQ_BASE_URL=https://api.groq.com/openai/v1
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
MISTRAL_BASE_URL=https://api.mistral.ai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# NVIDIA rejects inline images above a size cap rather than degrading, so the
# image is recompressed to fit instead of failing the request.
NVIDIA_MAX_IMAGE_B64_BYTES=180000

# Correct any stale price without editing source. USD per 1M tokens, as
# {"model-id": [input_rate, output_rate]}. Example:
# MODEL_PRICE_OVERRIDES={"qwen/qwen3.6-27b": [0.60, 3.00]}
MODEL_PRICE_OVERRIDES={}

LLM_TIMEOUT_SECONDS=90
# 1024 is too tight: a dense bill plus any reasoning tokens can exhaust it
# before the JSON closes, and you get a truncated response.
LLM_MAX_OUTPUT_TOKENS=2048

# Which providers the app actually offers. Every client stays in the codebase;
# this just controls what appears in the UI, the API and the report, so
# re-enabling one is a .env edit rather than a code change.
# Blank = allow all. Available: gemini, groq, moonshot, openrouter, nvidia,
#                               sambanova, mistral, claude, openai
ENABLED_PROVIDERS=gemini,groq,moonshot,nvidia

# The app refuses to start with fewer than 2 provider keys, because a
# one-model "comparison" is not a comparison. Set true to override.
ALLOW_SINGLE_PROVIDER=false

# ---------------------------------------------------------------------------
# Zoho Books (optional -- everything except the sync button works without it)
# ---------------------------------------------------------------------------
# 1. Sign up for the 14-day trial:  https://www.zoho.com/in/books/
# 2. API console -> Self Client -> Create:  https://api-console.zoho.in/
# 3. Generate the refresh token:  python scripts/get_refresh_token.py
#
# DATA CENTRE WARNING: an .in account issues tokens that only work against
# zohoapis.in. If you signed up on zoho.com, change BOTH domains below to the
# .com equivalents. Mismatched domains produce a misleading "invalid token".
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=

# Must match the Self Client registration EXACTLY, including port.
ZOHO_REDIRECT_URI=http://localhost:5173/zoho/callback
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_BOOKS_BASE_URL=https://www.zohoapis.in/books/v3

# Must be a real account name from your Zoho chart of accounts
# (Zoho Books -> Accountant -> Chart of Accounts).
ZOHO_DEFAULT_EXPENSE_ACCOUNT=Other Expenses

# Skip the name->id lookup by pinning the id. Worth doing: the lookup is the
# ONLY part of this flow needing ZohoBooks.accountants.READ, so setting this
# lets a narrow token work. Find it in Zoho Books -> Accountant ->
# Chart of Accounts -> click your expense account -> copy the number from the
# browser URL. Must be an *expense*-type account; income/asset are rejected.
ZOHO_EXPENSE_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
UPLOAD_DIR=./dataset/bills
MAX_IMAGE_SIZE_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Vercel gives every preview deployment a new random hostname, so an exact-match
# list can only cover production. This regex covers the rest. Scope it to your
# own project rather than all of vercel.app if the API is not meant to be public.
#   CORS_ORIGIN_REGEX=https://lextract-.*-sohins-projects-.*\.vercel\.app
CORS_ORIGIN_REGEX=
LOG_LEVEL=INFO
